SOURCE_FILE
  EXTERN_BLOCK
    ABI
      EXTERN_KW "extern" [] [WHITESPACE(" ")]
      STRING "\"C\"" [] [WHITESPACE(" ")]
    EXTERN_ITEM_LIST
      L_CURLY "{" [] [NEWLINE("\n")]
      DOC_COMMENT
        INNER_DOC_COMMENT "//! This is a doc comment" [WHITESPACE("    ")] [NEWLINE("\n")]
      ATTR
        POUND "#" [WHITESPACE("    ")] []
        BANG "!"
        L_BRACK "["
        TOKEN_TREE_META
          PATH
            PATH_SEGMENT
              NAME_REF
                IDENT "doc"
          TOKEN_TREE
            L_PAREN "("
            STRING "\"This is also a doc comment\""
            R_PAREN ")"
        R_BRACK "]" [] [NEWLINE("\n")]
      R_CURLY "}" [] [NEWLINE("\n")]
  EOF ""
