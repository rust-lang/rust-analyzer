SOURCE_FILE
  DOC_COMMENT
    INNER_DOC_COMMENT "//! docs" [COMMENT("// https://github.com/rust-lang/rust-analyzer/issues/357"), NEWLINE("\n"), NEWLINE("\n")] [NEWLINE("\n")]
  MODULE
    MOD_KW "mod" [COMMENT("// non-docs"), NEWLINE("\n")] [WHITESPACE(" ")]
    NAME
      IDENT "foo" [] [WHITESPACE(" ")]
    ITEM_LIST
      L_CURLY "{"
      R_CURLY "}"
  EOF ""
