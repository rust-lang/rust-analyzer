SOURCE_FILE
  MACRO_RULES
    ATTR
      POUND "#" [COMMENT("/// Some docs"), NEWLINE("\n")] []
      L_BRACK "[" [] []
      PATH_META
        PATH
          PATH_SEGMENT
            NAME_REF
              IDENT "macro_export" [] []
      R_BRACK "]" [] [NEWLINE("\n")]
    MACRO_RULES_KW "macro_rules" [] []
    BANG "!" [] [WHITESPACE(" ")]
    NAME
      IDENT "foo" [] [WHITESPACE(" ")]
    TOKEN_TREE
      L_CURLY "{" [] [NEWLINE("\n")]
      TOKEN_TREE
        L_PAREN "(" [WHITESPACE("    ")] []
        R_PAREN ")" [] [WHITESPACE(" ")]
      EQ "=" [] []
      R_ANGLE ">" [] [WHITESPACE(" ")]
      TOKEN_TREE
        L_CURLY "{" [] []
        R_CURLY "}" [] []
      SEMICOLON ";" [] [NEWLINE("\n")]
      R_CURLY "}" [] [NEWLINE("\n")]
  EOF "" [] []
