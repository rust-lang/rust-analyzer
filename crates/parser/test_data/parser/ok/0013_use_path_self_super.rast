      PATH
        PATH
          PATH_SEGMENT
            NAME_REF
              SELF_KW "self" [] []
        COLON2 "::" [] []
        PATH_SEGMENT
          NAME_REF
            IDENT "foo" [] []
    SEMICOLON ";" [] [NEWLINE("\n")]
  USE
    USE_KW "use" [] [WHITESPACE(" ")]
    USE_TREE
      PATH
        PATH
          PATH
            PATH_SEGMENT
              NAME_REF
                SUPER_KW "super" [] []
          COLON2 "::" [] []
          PATH_SEGMENT
            NAME_REF
              SUPER_KW "super" [] []
        COLON2 "::" [] []
        PATH_SEGMENT
          NAME_REF
            IDENT "bar" [] []
